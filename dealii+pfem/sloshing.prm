# Parameter file for PFEM 2D Free Surface Sloshing Simulation
# Based on dam-break / sloshing tank benchmark problem

# Physical parameters
set Density = 1000.0      # Water density [kg/m³]
set Viscosity = 0.001     # Dynamic viscosity [Pa·s]
set GravityX = 0.0        # Gravity in x-direction [m/s²]
set GravityY = -9.81      # Gravity in y-direction [m/s²]

# Time stepping
set TimeStep = 0.0005     # Time step size [s]
set TotalTime = 2.0       # Total simulation time [s]
set OutputInterval = 100  # Output every N steps

# Domain parameters (rectangular tank)
set TankLength = 1.0      # Tank length [m]
set TankHeight = 0.6      # Tank height [m]

# Initial water column (dam break configuration)
set InitialWaterLength = 0.4  # Initial water column width [m]
set InitialWaterHeight = 0.3  # Initial water column height [m]
set InitialTiltAngle = 0.0    # Initial tilt angle [degrees]

# Mesh parameters
set MeshSize = 0.02               # Particle spacing [m]
set AlphaShapeRadiusFactor = 1.2  # Alpha shape radius = factor * mesh_size
set RemeshThreshold = 10.0        # Remesh when min angle < threshold [degrees]

# Boundary conditions
set WallFriction = 0.0    # Wall friction coefficient (0 = free slip)
set Damping = 0.0         # Global damping coefficient (0 = no damping)
